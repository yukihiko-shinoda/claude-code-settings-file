{
  "permissions": {
    "allow": [],
    "ask": [
      "Bash(git push*)",
      "Bash(git * push*)",
      "Bash(rm*)"
    ],
    "deny": [
      "Read(~/.config/op/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(//run/secrets/*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/datasets/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "enableWeakerNestedSandbox": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "credentials": {
      "files": [
        {
          "path": "~/.config/gh/hosts.yml",
          "mode": "mask",
          "extract": "oauth_token:\\s*(\\S+)",
          "onExtractNoMatch": "deny",
          "injectHosts": [
            "api.github.com"
          ]
        }
      ]
    },
    "filesystem": {
      "denyRead": [
        "~/.config/op/",
        "~/.aws/",
        "/run/secrets/",
        "**/.env",
        "**/.env.*",
        "~/.ssh/",
        "~/datasets"
      ],
      "denyWrite": [
        "~/.config/op/",
        "~/.aws/",
        "~/.config/gh/",
        "/run/secrets/",
        "**/.env",
        "**/.env.*",
        "~/.ssh/",
        "~/datasets"
      ]
    },
    "network": {
      "tlsTerminate": {},
      "allowedDomains": [
        "api.github.com",
        "github.com"
      ]
    }
  }
}
